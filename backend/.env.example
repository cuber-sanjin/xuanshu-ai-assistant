# ===== 玄枢环境变量示例 =====
# 复制本文件为 .env 并填写真实值（.env 已被 .gitignore 忽略）

# 阿里云百炼 API Key（必填）
# 读取优先级：环境变量 AI_CHAT_API_KEY > 环境变量/.env 的 DASHSCOPE_API_KEY
# 获取地址：https://bailian.console.aliyun.com/ → API-KEY 管理
# 若已配置系统环境变量 AI_CHAT_API_KEY，则 .env 中无需再填
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 主对话模型（Phase 6 起记忆提取会用独立的快速模型，此处先占位主模型）
LLM_MODEL=qwen-plus

# 记忆提取模型（结构化判定任务，用便宜的快速模型，可覆盖）
EXTRACTOR_MODEL=qwen-flash

# 语音合成模型与默认音色（Cherry 女 / Serena 女 / Ethan 男）
TTS_MODEL=qwen3-tts-flash
TTS_VOICE=Cherry

# 语音识别模型（百炼 ASR，支持 OpenAI 兼容接口 + base64 上传）
ASR_MODEL=qwen3-asr-flash

# 百炼 OpenAI 兼容接口地址（官方推荐，无需修改）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# LLM 采样温度（0-2，越低越稳定，工具调用场景建议偏低）
LLM_TEMPERATURE=0.7

# 后端服务端口
SERVER_PORT=8000

# ===== 向量检索 RAG（可选） =====
# 开启后：笔记/记忆检索升级为"语义优先 + 关键词兜底"的混合召回（需外网调用嵌入模型）
# 关闭（默认）：行为与旧版完全一致（SQL LIKE / importance 排序）
EMBEDDING_ENABLED=false
# 嵌入模型（百炼 text-embedding-v3，OpenAI 兼容接口）
EMBEDDING_MODEL=text-embedding-v3
# 嵌入维度（v3 默认 1024）
EMBEDDING_DIMENSIONS=1024
